# 运行环境标识。开发机用 development，服务器可改为 production。
APP_ENV=development

# 对外访问本服务的基础地址，用于生成下载代理链接。
# 本地开发通常保持 localhost；部署到服务器时改成反向代理后的公网或内网地址。
PUBLIC_BASE_URL=http://localhost:11010

# 服务监听端口。docker-compose 默认映射 11010:8080。
PORT=8080

# 轻量状态目录：provider cache、metadata、日志等。
# 本地开发可用相对路径；容器中通常由 docker-compose 覆盖为 /app/data。
DATA_DIR=./data

# 临时目录：下载中的 .part 文件和 XAPK 打包工作目录。
# 可安全清理，但不要指向最终 artifact 目录。
TEMP_DIR=./tmp

# 非 Docker 本地运行时，最终 APK/XAPK/APKS artifact 保存目录。
# docker-compose.yml 中容器内路径固定为 /mnt/nas/apks，本变量不会改变 compose 的挂载目标。
# 本地直接跑 uvicorn 时保留 ./artifacts 即可。
NAS_MOUNT_PATH=./artifacts

# 正式 docker-compose.yml 使用 CIFS 挂载 NAS volume 时需要这些变量。
# 正式 Docker 的 NAS 路径由 NAS_HOST/NAS_SHARE_PATH 等决定，容器内固定挂到 /mnt/nas/apks。
# 本地测试脚本会使用 dev compose 变体和本地目录映射，不需要填写真实 NAS 信息。
NAS_HOST=192.168.1.10
NAS_PORT=445
NAS_USER=your_user
NAS_PASSWORD=your_password
NAS_SHARE_PATH=apks

# 单文件最大下载字节数，默认 5 GiB。
# 大型游戏包不足时再调大，避免异常响应或错误链接撑爆磁盘。
DOWNLOAD_MAX_FILE_BYTES=5368709120

# 下载大包时的网络超时。读超时表示连续多久没有收到新数据才断开，不是总下载时长。
# 5 GiB 游戏包遇到慢网时可继续调大 READ 和 GUNICORN 超时。
DOWNLOAD_READ_TIMEOUT_SECONDS=900
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=60
WEB_CONCURRENCY=6
GUNICORN_TIMEOUT_SECONDS=21600

# fake provider 只用于本地开发和测试，返回内置小样本包。
PROVIDER_FAKE_ENABLED=true

# 故意失败的 fake provider，用于验证 provider fallback；生产可关闭。
PROVIDER_FAKE_FAILING_ENABLED=true

# 真实 provider 开关。接入对应阶段后再逐个打开。
PROVIDER_APKPURE_SIGNED_ENABLED=false
PROVIDER_GOOGLE_PLAY_ENABLED=false
PROVIDER_APTOIDE_ENABLED=false
PROVIDER_APKPURE_PROTO_ENABLED=false
PROVIDER_APKPURE_WEB_ENABLED=false
# APKMirror 深历史源（二期）：产物 .apkm 解包重建 .xapk，作历史 fallback。
PROVIDER_APKMIRROR_ENABLED=false

# provider 自动 fallback 优先级，数值越大越先尝试。
PROVIDER_APKPURE_SIGNED_PRIORITY=100
PROVIDER_GOOGLE_PLAY_PRIORITY=90
PROVIDER_APTOIDE_PRIORITY=80
PROVIDER_APKPURE_PROTO_PRIORITY=70
PROVIDER_APKPURE_WEB_PRIORITY=20
PROVIDER_APKMIRROR_PRIORITY=15

# 出站网络代理。访问 Google Play/APKPure 需要代理时填写。
# 示例：http://127.0.0.1:7890 或 socks5://127.0.0.1:7890；不需要代理时留空。
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=

# APKPure / Google Play 系 provider（apkpure-signed / apkpure-web / google-play）专用上游代理。
# 仅支持 HTTP/HTTPS 且需带鉴权，格式 http://USER:PASS@HOST:PORT；不支持 SOCKS5。
# 用于：Cloudflare 拦 Aurora dispenser / APKPure CDN（403），或本机出口把 CDN 解析到 198.18/15
# 假 IP 触发 SSRF 拦截。留空则直连。配置后这些 provider 的全部上游流量（取 token、签名/Play API、
# 网页抓取、CDN 下载）统一走该代理，保证出口 IP 一致。
UPSTREAM_PROXY=

# NAS 自带 HTTP 文件服务（nginx）对外前缀；其根须对应 NAS_MOUNT_PATH 根。
# 留空（默认）：/download 由本服务从 NAS 读出再流式返回。
# 配置后：/download 改为 302 重定向到 NAS 直链，大包传输卸到 NAS 直供、解放容器。
# 仅当下游客户端能直连此地址时启用（内网/同网段）。示例：
# NAS_PUBLIC_BASE_URL=http://192.168.1.10/android-packages
NAS_PUBLIC_BASE_URL=

# 版本目录（阶段 10–14）。库落本地 DATA_DIR/version-catalog.sqlite（持久卷，勿放 NAS）。
# 下载后回填名↔号账本（旁路，关掉只停积累、不影响下载）。
CATALOG_BACKFILL_ENABLED=true
# 按需收集 TTL 门 / 收集租约（跨 worker 单飞，超时可重抢）。
CATALOG_COLLECT_TTL_HOURS=6
CATALOG_COLLECTION_LEASE_SECONDS=600
# 后台定时刷新：进程内调度器，多 worker 用 scheduler_lock 选主，默认每 5h 对已跟踪包跑增量。
CATALOG_REFRESH_ENABLED=true
CATALOG_REFRESH_INTERVAL_HOURS=5
CATALOG_SCHEDULER_LEASE_SECONDS=900
# 主动归档（阶段 16）：增量发现新版本即下载入 NAS 档案馆。默认关（开后会自动触发下载/占带宽）。
ARCHIVE_ENABLED=false
ARCHIVE_CONCURRENCY=1
ARCHIVE_MAX_RETRIES=2
# AppMagic known 时间线（阶段 17）：内部监控源，补 known 层（无 code、不进对外 /versions）。默认关。
# 接口公开匿名可取，开关开即生效、无需 cookie/登录；被 Cloudflare 拦会自动走 Playwright 兜底（走 UPSTREAM_PROXY）。
APPMAGIC_ENABLED=false
APPMAGIC_COUNTRY=US
APPMAGIC_STORE=1
