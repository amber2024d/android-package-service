# 云上部署 env 模板（配合 docker-compose.cloud.yml）。复制为 .env.cloud 后填写：
#   docker compose -f docker-compose.yml -f docker-compose.cloud.yml --env-file .env.cloud up -d --build
# 不含 NAS 段（产物走对象存储）。敏感项（密钥/私钥）勿提交仓库。

# 运行环境。生产用 production（会话 cookie 自动加 Secure）。
APP_ENV=production

# 对外访问本服务的基础地址，必须是外部可达的 https 地址。
# 它同时决定：飞书 OAuth 回调 {PUBLIC_BASE_URL}/auth/callback、下载任务返回的 statusUrl/fileUrl。
# 飞书开放平台「安全设置 → 重定向 URL」须登记 {PUBLIC_BASE_URL}/auth/callback（逐字一致）。
PUBLIC_BASE_URL=https://android-packages.example.com

# ---- 鉴权（公网必开）--------------------------------------------------------
AUTH_ENABLED=true
AUTH_API_KEY_ENABLED=true
# 飞书自建应用 App ID / App Secret（首页/监控面板的单管理员 OAuth 登录用）。
FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=xxxxx
FEISHU_AUTH_BASE=https://accounts.feishu.cn
FEISHU_API_BASE=https://open.feishu.cn
SESSION_TTL_HOURS=24

# ---- 对象存储 ---------------------------------------------------------------
# s3 | gcs。
STORAGE_BACKEND=s3
STORAGE_PREFIX=artifacts
SIGNED_URL_TTL_SECONDS=3600

# S3 / 兼容（STORAGE_BACKEND=s3）。S3_ENDPOINT_URL 留空即 AWS，填则兼容 MinIO 等自建端点。
S3_BUCKET=android-packages-prod
S3_REGION=us-west-2
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# GCS（STORAGE_BACKEND=gcs）。v4 signed URL 需带私钥的服务账号：把 SA key 文件挂进容器
# （见 docker-compose.cloud.yml 注释），GCS_CREDENTIALS_JSON 指向容器内路径。
GCS_BUCKET=
GCS_CREDENTIALS_JSON=

# ---- provider / 代理（按需）------------------------------------------------
# 访问 Google Play / APKPure 系需要出站代理时填写（HTTP/HTTPS，含鉴权，不支持 SOCKS5）。
UPSTREAM_PROXY=
# 真实来源按需开启（默认关）。
PROVIDER_GOOGLE_PLAY_ENABLED=false
PROVIDER_APKPURE_SIGNED_ENABLED=false

# ---- 目录 / 归档（按需）----------------------------------------------------
CATALOG_REFRESH_ENABLED=true
ARCHIVE_ENABLED=false
